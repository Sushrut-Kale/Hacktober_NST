# =====================================================================
# VIKASA Platform Configuration Template (.env.example)
# Note: Use placeholder values only. Never commit production secrets.
# =====================================================================

# -------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# -------------------------------------------------------------
APP_NAME=VIKASA
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Database Connection
# Local Development: SQLite
DATABASE_URL=sqlite:///./vikasa.db
# Production Relational Database (PostgreSQL):
# DATABASE_URL=postgresql://vikasa_user:your_secure_password@localhost:5432/vikasa_prod

# CORS Allowed Origins (Comma-separated)
# In production, set to your specific frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Subprocess & Execution Limits
MAX_EXECUTION_TIMEOUT_SECONDS=30
MAX_OUTPUT_BYTES=524288
MAX_FILES_INSPECTED=500

# -------------------------------------------------------------
# Optional Local / Remote AI Engine (Ollama)
# -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=10.0

# -------------------------------------------------------------
# Optional GitHub API Integration (Rate limits & Private Repos)
# -------------------------------------------------------------
# Optional GitHub personal access token for higher API rate limits.
# Kept strictly server-side. Never exposed to browser bundles.
GITHUB_API_TOKEN=

# -------------------------------------------------------------
# Optional Antigravity IDE / Agent Integration
# -------------------------------------------------------------
# Path to Antigravity CLI executable if installed outside PATH
ANTIGRAVITY_CLI_PATH=

# -------------------------------------------------------------
# Frontend Application Configuration (Next.js)
# -------------------------------------------------------------
# Publicly accessible backend API URL consumed by the browser client
NEXT_PUBLIC_API_URL=http://localhost:8000
